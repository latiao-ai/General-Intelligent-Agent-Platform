{
  "contracts": [
    {
      "contract_id": "openmontage-video-v1",
      "version": 1,
      "submit_tool_key": "mcp:openmontage:render_video",
      "remote_id_pointer": "/job_id",
      "status_tool_key": "mcp:openmontage:get_job_status",
      "status_id_argument": "job_id",
      "status_pointer": "/status",
      "status_map": {
        "pending": "accepted",
        "queued": "accepted",
        "running": "running",
        "completed": "succeeded",
        "failed": "failed",
        "cancelled": "cancelled",
        "interrupted": "unknown"
      },
      "output_pointer": "/artifacts",
      "cancel_tool_key": "mcp:openmontage:cancel_job",
      "poll_interval_seconds": 5,
      "deadline_seconds": 1800,
      "recoverable": true
    },
    {
