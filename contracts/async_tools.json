      "status_id_argument": "job_id",
      "status_pointer": "/status",
      "status_map": {
        "pending": "accepted",
        "queued": "accepted",
        "running": "running",
        "completed": "succeeded",
        "failed": "failed",
        "cancelled": "cancelled",
        "interrupted": "unknown"
      },
      "output_pointer": "/artifacts",
      "cancel_tool_key": "mcp:openmontage:cancel_job",
