# Copy outside source control to deploy/production.env and chmod 600.
APP_ENV=production

# 运行数据落盘位置。容器/多副本部署必须挂共享存储，且各副本使用相同的绝对路径；
# 不要用各主机自己的本地目录，否则产物与画像会分裂。
ARTIFACT_DIR=/data/artifacts
PROFILE_PATH=/data/profile/USER.md

AUTH_MODE=ticket
AUTH_DEV_COMPAT=false
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_ALLOWED_ORIGINS=https://agent.example.com
AUTH_CONNECTIONS_FILE=/config/auth-connections.json
POLICY_LEGACY_VISIBLE=false
DB_AUTO_MIGRATE=false
LLM_API_KEY=replace-me
LLM_MODEL=replace-with-your-model
LLM_BASE_URL=https://your-model-gateway.example/v1
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Portable JSON file. Secrets are injected as environment variables.
MCP_SERVERS_FILE=/config/mcp-servers.json
PUBLISH_MCP_URL=https://your-publisher.example/mcp
PUBLISH_MCP_TOKEN=replace-me
MCP_ALLOW_LOOPBACK_HTTP=false
DEPLOY_ENABLED=false
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
USER_RATE_LIMIT_PER_MINUTE=60
TENANT_BUDGET_ENABLED=true
TENANT_DAILY_PROVIDER_REQUESTS=1000
# One currency throughout. 1,000,000 micros = 1 currency unit. UTC daily reset.
TENANT_DAILY_COST_MICROS=10000000
# MUST supply upper-bound prices matching your gateway/model before starting.
# Price values below intentionally fail the production startup checks.
LLM_INPUT_PRICE_MICROS_PER_MILLION=0
LLM_OUTPUT_PRICE_MICROS_PER_MILLION=0
SEARCH_REQUEST_COST_MICROS=0
MAX_CONCURRENT_RUNS=16
# 不是按一条运行一条连接换算。池再小，并发 16 的突发写账会排到 DB_POOL_TIMEOUT。
# 别超过服务端 max_connections ÷ 副本数。
DB_POOL_SIZE=8
# 单次运行 token 合计上限（输入+输出）。账在 provider_charges，不在 runs.consumed_json。
RUN_MAX_TOKENS=1000000
RUN_MAX_PROVIDER_REQUESTS=32
DB_POOL_TIMEOUT=10
METRICS_FORMAT=prometheus
RETENTION_EVENTS_DAYS=30
RETENTION_ARTIFACTS_DAYS=30
MAINTENANCE_INTERVAL_SECONDS=3600
LOG_LEVEL=INFO
