LLM_API_KEY=replace-me
LLM_MODEL=replace-with-your-model-id
# 整理报告阶段单独用更快的模型；留空则沿用 LLM_MODEL。
LLM_COMPOSE_MODEL=
# 解析阶段关闭模型推理：实测多轮场景 4.4s → 2.3s（约 2 倍），准确率不变。
# 整理报告阶段【不要】开这个：关掉后无法产出合法的结构化输出。
LLM_PARSE_DISABLE_THINKING=true
# 留空时使用 ChatOpenAI 适配器的默认 endpoint；其他兼容服务填完整 API base URL。
LLM_BASE_URL=
# 检索走 DeepSeek 官方 Search/Fetch API。
# 这个 key 是 api.deepseek.com 的平台 key，与 LLM_BASE_URL 的网关 key 不是一回事
# （拿网关 key 调官方接口会 401）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MAX_PAGES=5
# 字符预算，不是 token 数；长文首版会截断，并记录限制。
# 单篇上限 × 来源数 ≈ 总量：单篇设成和总量一样大，第一个来源就吃光预算，
# 报告会退化成单一来源。10000/3000 大约能装下 3~4 个来源。
MAX_SOURCE_CHARS=3000
MAX_TOTAL_CHARS=10000
# 单次模型调用的硬超时（秒）。超时直接失败、不重试，换取确定的等待上限。
# 注意：它乘以重试次数要小于下面的 TASK_TIMEOUT，否则外层会先砍断内层重试。
LLM_ATTEMPT_TIMEOUT=180
# ---------- 执行预算（文档 §7：步数/时长可配，不写死在代码里） ----------
# 计划最多几步
MAX_STEPS=8
# 单次任务总预算（秒）
TASK_TIMEOUT=300
# LangGraph 递归上限（每个步骤算一跳）
GRAPH_RECURSION_LIMIT=30
# run 租约时长（秒）。执行期间会持续续租；设太短，别的执行者会误判"人死了"并接手
RUN_LEASE_SECONDS=120
# 创建任务的幂等键有效期（秒）。客户端用 Idempotency-Key 头重试时，
# 同一个键 + 同样的内容只会产生一个任务；超过这个时间后键可以被重用。
IDEMPOTENCY_TTL_SECONDS=86400
# 日志级别：DEBUG / INFO / WARNING
LOG_LEVEL=INFO
ARTIFACT_DIR=artifacts
# 先设为 false，只生成本地 HTML。
DEPLOY_ENABLED=false
MCP_TRANSPORT=streamable_http
MCP_URL=https://your-server.example/mcp
MCP_BEARER_TOKEN=
# 对照 list_tools 的 inputSchema 填写。
MCP_TOOL_NAME=replace-with-real-tool-name
MCP_HTML_FIELD=html
MCP_EXTRA_ARGS={}
# 对照真实工具返回字段填写，可用点分隔路径，如 data.url。
MCP_RESULT_URL_FIELD=public_url

# ---------- 多 MCP Server（可选） ----------
# 设置 MCP_SERVERS 后，上面的 MCP_URL / MCP_TRANSPORT / MCP_TOOL_NAME 等
# 单项配置不再使用，改为每个服务端各自配置（JSON 数组）：
#   id            必填，工具名前缀用它（不能含 "__"）
#   transport     streamable_http / sse / stdio
#   url / token   http 类传输必填 url
#   stdio_command stdio 传输必填，stdio_args 为字符串数组
#   deploy_tool   这个服务端承接部署时用的工具名
#   default       true 表示由它承接 deploy_site 这类适配器工具
# 只有一个服务端时工具名仍是 mcp__<tool>（兼容已保存的计划）；
# 有多个时是 mcp__<server_id>__<tool>，避免同名工具跨服务端互相覆盖。
# MCP_SERVERS=[{"id":"publishing","url":"https://a.example/mcp","token":"","deploy_tool":"deploy_site","default":true},{"id":"ops","url":"https://b.example/mcp"}]

# SQLite 持久化文件（会话、任务、事件日志）
DB_PATH=agent.db
# 数据库：留空用 SQLite（DB_PATH）；填 postgresql:// 则全部走 PostgreSQL
DATABASE_URL=

# ---------- 身份（旧 token 模式，保留兼容；新接入请用下方 ticket 模式） ----------（app/auth.py） ----------
# off      = 不介入，保持单用户行为（默认；本地开发与既有测试不受影响）
# optional = 带了 token 就验证，没带就匿名（灰度期）
# token    = 必须带合法 token，否则 401（正式启用）
AUTH_MODE=off
# 只作标签，落 identities.provider；同一平台同一主体不会重复建号
AUTH_PROVIDER=oidc
# 平台 userinfo 端点。留空时 token 模式会明确 401，不会静默放行
AUTH_USERINFO_URL=
# header = Authorization: Bearer；query = ?access_token=（部分平台只认这个）
AUTH_TOKEN_IN=header
# 平台返回字段映射，支持 a.b 取嵌套（如 data.userId）
AUTH_SUBJECT_FIELD=sub
AUTH_EMAIL_FIELD=email
AUTH_NAME_FIELD=name
# 凭证校验结果的进程内缓存（秒）。0 = 每次都问平台。
# 这是性能必需：一次任务有几十个请求，全打平台会被限流
AUTH_CACHE_TTL=60
AUTH_TIMEOUT=5
# 浏览器侧凭证。EventSource 与 <a download> 发不了自定义头，只能靠 cookie
AUTH_COOKIE_NAME=agent_token
# 本地 http 调试设 false，否则浏览器拒收；线上必须 true
AUTH_COOKIE_SECURE=true
# cookie 存活时长（秒），与 AUTH_CACHE_TTL 无关
AUTH_COOKIE_MAX_AGE=28800

# ---------- 对象权限 ----------
# owner_user_id='default' 的存量数据是否对所有登录用户可见。
# AUTH_MODE=ticket 时必须 false，否则等于把存量历史公开给所有登录用户。
POLICY_LEGACY_VISIBLE=false
