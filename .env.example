# Development settings. Production: use deploy/production.env.example instead.
# APP_ENV=production must be injected by the deployment environment; it disables .env loading.
APP_ENV=development
DB_AUTO_MIGRATE=true
API_RATE_LIMIT_ENABLED=false
TENANT_BUDGET_ENABLED=false
# Optional portable registry; ${VAR} inside its JSON strings is expanded from the environment.
# MCP_SERVERS_FILE=/config/mcp-servers.json
# 用户自建远程 MCP（与 WorkBuddy mcp.json 同形态），**一个主体一个文件**：
#   <MCP_USER_CONFIG_DIR>/<tenant>__<user>.json。默认 profile/mcp-users。
# 这是唯一的用户级存放位置；两个用户各自加一个同名连接器互不影响。
# MCP_USER_CONFIG_DIR=/config/mcp-users
# 兼容期的全局单文件：配了它，其中条目对**所有用户**可见（scope=shared）。
# 新部署不要用它；老部署迁移时把它拆进上面的目录即可。
# MCP_USER_CONFIG_FILE=/config/mcp-user.json

LLM_API_KEY=replace-me
LLM_MODEL=replace-with-your-model-id
# 解析阶段关闭模型推理：实测多轮场景 4.4s → 2.3s（约 2 倍），准确率不变。
LLM_PARSE_DISABLE_THINKING=true
# 留空时使用 ChatOpenAI 适配器的默认 endpoint；其他兼容服务填完整 API base URL。
LLM_BASE_URL=
# 检索走 DeepSeek 官方 Search/Fetch API。
# 这个 key 是 api.deepseek.com 的平台 key，与 LLM_BASE_URL 的网关 key 不是一回事
# （拿网关 key 调官方接口会 401）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MAX_PAGES=3
# 字符预算，不是 token 数；长文会截断并记录限制。
# 单篇上限 × 来源数 ≈ 总量：单篇设成和总量一样大，第一个来源就吃光预算。
MAX_SOURCE_CHARS=3000
MAX_TOTAL_CHARS=6000
# Registered host platform scene budget; applies to every platform equally.
PLATFORM_CONTEXT_MAX_CHARS=12000
# 单次模型调用的硬超时（秒）。超时直接失败、不重试，换取确定的等待上限。
# 注意：它乘以重试次数要小于下面的 TASK_TIMEOUT，否则外层会先砍断内层重试。
LLM_ATTEMPT_TIMEOUT=180
# 完整模型请求预算。按实际模型的窗口配置，预留输出与安全余量。
# 输入使用 UTF-8 字节上界保守估算；包含规则、消息和工具 schema。
LLM_CONTEXT_WINDOW=32768
LLM_INPUT_BUDGET=24576
LLM_OUTPUT_TOKENS=4096
LLM_CONTEXT_MARGIN=2048
# 网络/限流有限重试的最长等待秒数；Retry-After 更长时不提前重发。
LLM_RETRY_MAX_DELAY=2
# ---------- 执行预算（步数/时长可配，不写死在代码里） ----------
# 计划最多几步
MAX_STEPS=8
# 单次任务总预算（秒）
TASK_TIMEOUT=300
# LangGraph 递归上限（每个步骤算一跳）
GRAPH_RECURSION_LIMIT=30
# run 租约时长（秒）。执行期间会持续续租；设太短，别的执行者会误判"人死了"并接手
RUN_LEASE_SECONDS=120
# 创建任务的幂等键有效期（秒）。客户端用 Idempotency-Key 头重试时，
# 同一个键 + 同样的内容只会产生一个任务；超过这个时间后键可以被重用。
IDEMPOTENCY_TTL_SECONDS=86400
# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL。
# 这是**启动时**的值；控制台「日志」页可以在运行期临时调，重启后回到这里。
LOG_LEVEL=INFO
# 日志文件目录（可选）。不填就是 $ARTIFACT_DIR/logs，按 10MB × 5 份轮转。
# 多副本部署要指到各副本都能写的目录，否则只有本机那台有文件。
# LOG_DIR=
# 是否落文件（默认落；APP_ENV=test 与 pytest 下自动关闭）。设 0 只写 stdout。
# LOG_TO_FILE=1
# 控制台实时日志在内存里保留多少条（默认 2000）。调大占内存，调小翻不到刚才那条。
# LOG_BUFFER_SIZE=2000
ARTIFACT_DIR=artifacts
# 用户画像（跨会话记忆）落盘位置。相对路径按项目根解析；多副本部署必须指向
# 各副本都能读写的共享目录，并保持相同的绝对路径。
PROFILE_PATH=profile/USER.md
# 闲聊写记忆/画像的触发策略：always（默认，每轮都让模型自己判断值不值得记）、
# cue（只在不命中关键词时跳过，省一次小模型调用，但会漏"我来自台州"这类说法）、
# off（关掉自动抽取，画像只由任务规划和手工编辑写入）。
# MEMORY_EXTRACT_MODE=always
# 抽取最长等待（秒）。超时只放弃这一轮的画像补充，答复照发；<=0 不限。
# MEMORY_EXTRACT_TIMEOUT=12
# 先设为 false，只生成本地 HTML。
DEPLOY_ENABLED=false
MCP_TRANSPORT=streamable_http
MCP_URL=https://your-server.example/mcp
MCP_BEARER_TOKEN=
# 对照 list_tools 的 inputSchema 填写。
MCP_TOOL_NAME=replace-with-real-tool-name
MCP_HTML_FIELD=html
MCP_EXTRA_ARGS={}
# 对照真实工具返回字段填写，可用点分隔路径，如 data.url。
MCP_RESULT_URL_FIELD=public_url

# ---------- 多 MCP Server（可选） ----------
# 设置 MCP_SERVERS 后，上面的 MCP_URL / MCP_TRANSPORT / MCP_TOOL_NAME 等
# 单项配置不再使用，改为每个服务端各自配置（JSON 数组）：
#   id            必填，工具名前缀用它（不能含 "__"）
#   transport     streamable_http / sse / stdio
#   url / token   http 类传输必填 url
#   stdio_command stdio 传输必填，stdio_args 为字符串数组
#   stdio_env     stdio 子进程的非敏感环境配置
#   forward_subject true 时从已验证运行注入 MCP_CALLER_SUBJECT，按客户隔离子进程
#   planning_tools 必须随业务工具保留的已授权上下文工具原始名称数组
#                 stdio 凭据由传输层注入 MCP_BEARER_TOKEN，不写入模型上下文
#   deploy_tool   这个服务端承接部署时用的工具名
#   default       true 表示由它承接 deploy_site 这类适配器工具
#   tool_hints    某个工具的本机用法，键是工具名或 run_tool 的内部名
#   prompt_rules  这一家自己的规划规则。只在它的工具进入本轮清单时拼进提示词。
#                 不要把某一家的工具名写进内核。
#   deterministic_reasons  这一家自己的"请求被拒、没落地"原因词（字符串数组）。
#                 内核默认只认 invalid_/missing_/unsupported_/stale_ 前缀、
#                 _conflict/_mismatch/_rejected/_forbidden/_unauthorized 后缀，
#                 以及 invalid_argument/precondition_failed/revision_conflict/
#                 node_kind_mismatch/forbidden/unauthorized。
#                 厂商专有词（例：BeefTV 的 read_only_client）必须写在这里，
#                 否则会被当成"结果未定"，走人工对账而不是确定失败。
#                 只放**语义上确实没执行**的词；拿不准就别放（重试可能重复写入）。
#   confirmation_tools  必须由用户在外部平台确认后才能执行的工具（付费下单、提交/下发）。
#                 同一片段里只要还出现它的**提议**步骤或该服务端的写操作，规划校验
#                 直接阻断（confirmation_bypasses_user）：自导自演不能当作用户已确认。
#   proposal_tools  触发那次确认的提议工具（只登记提议、不执行）。
# 只有一个服务端时工具名仍是 mcp__<tool>（兼容已保存的计划）；
# 有多个时是 mcp__<server_id>__<tool>，避免同名工具跨服务端互相覆盖。
# MCP_SERVERS=[{"id":"publishing","url":"https://a.example/mcp","token":"","deploy_tool":"deploy_site","default":true},{"id":"ops","url":"https://b.example/mcp"}]
#
# 通用服务（谁都能用）与平台私有服务的区别在**绑定**，不在配置：
#   - 平台私有：bind_platform_mcp.py --tenant <企业> --platform <平台> --server <id>
#   - 通用：    ALLOW_GLOBAL_BIND=true bind_platform_mcp.py --server <id> --audience global
# 通用服务用 --tools / --inner-tools 收敛暴露面（内层白名单不写＝一个都不许）。
# 密钥不要写进这里的 token 字段，走 credential_ref：env:NAME / file:/path。
#
# 部署类服务端（承接 deploy_tool 的那个）落在本机时示意：
# {"id":"publishing","title":"HTML 部署（公网）","transport":"streamable_http",
#  "url":"http://deploy.example/mcp","deploy_tool":"deploy_site",
#  "result_url_field":"url","default":true}
#
# 连接器授权有两种接法，按部署形态选（不要同时挂两个同名连接器）：
#
# (A) 中台自己走 OAuth —— **多人共用一个中台时只能用这个**
#     每个登录用户各自授权、各自持 token；凭据落 OAUTH_DIR（一人一份，0600），
#     绑定记在 credential_bindings（subject_kind=user）。调用前自动 refresh。
#     用户第一次点连接器面板里的「授权」扫一次码即可，不需要填任何 token。
#     LibTV 的授权服务器支持动态注册（/.well-known/oauth-authorization-server
#     里有 registration_endpoint），所以**不用去后台申请应用**。
#     {"id":"libtv","title":"LibTV 视频/图片/音频创作","transport":"streamable_http",
#      "url":"https://mcp.liblib.tv/mcp","auth":"oauth",
#      "oauth":{"issuer":"https://mcp.liblib.tv",
#               "scopes":["libtv:account:read","libtv:project:read","libtv:project:write",
#                         "libtv:media:write","libtv:task:write","libtv:export:write"],
#               "client_name":"智能体中台"}}
#
#     对方**不支持**动态注册（没有 registration_endpoint）时必须先在其后台报备，
#     再补上应用级凭据；secret 走引用，不写明文：
#     "oauth":{"client_id":"xxxx","client_secret_ref":"env:LIBTV_CLIENT_SECRET",...}
#
# (B) 本机单用户的 stdio 桥 —— 只适合"中台装在每个用户自己电脑上"
#     桥自己管 token，中台完全不参与授权；多人共用一个中台时，所有人共用
#     同一份 ~/.libtv/credentials.json（也就是同一个微信身份），项目与配额会串。
#     首次授权：node lib/cli.mjs login（微信扫码，凭据落 ~/.libtv/credentials.json，
#     access token 约 1 小时到期、由 refresh token 自动续期）
#     {"id":"libtv-local","title":"LibTV（本机桥）","transport":"stdio",
#      "stdio_command":"node","stdio_args":["/absolute/path/dsh-libtv/lib/main.mjs"],
#      "stdio_env":{"LIBTV_HOME":"/absolute/path/.libtv"}}
# 注意：长任务（视频生成/导出）可能超过 call_tool 的 90s 超时，需放宽或走异步合同。

# OAuth 凭据落盘目录（一人一份，文件权限 0600）。默认 secrets/oauth。
# OAUTH_DIR=secrets/oauth
# 授权回调的对外地址前缀。**生产必须配**：反代之后按请求推断会拿到内网 http，
# 和动态注册时报给对方的地址不一致，授权服务器会在回调阶段直接拒绝。
# 本机联调留空即可（会推断成 http://127.0.0.1:8002）。
# OAUTH_PUBLIC_BASE=https://agent.example.com
# 授权 state 有效期（秒）。state 是一次性凭证，过期不候。
# OAUTH_STATE_TTL_SECONDS=600

# ---------- 标准 MCP Tasks 原语（实验，默认全关） ----------
# 服务端在工具元数据里声明 Tool.execution.taskSupport（forbidden/optional/required）
# 时，中台可以按协议任务通道调用（callTool 带 task，用 tasks/get 轮询），
# 这类服务端**不需要异步合同**。
#
# 默认关闭的原因：mcp 库已把这条通道标为弃用（tasks 已移出 MCP 规范，mcp 2.0 会移除），
# 且访问 session.experimental 会抛 DeprecationWarning。requirements 的 mcp<2 上界
# 是当前唯一的保护。详见 README §10。
# MCP_TASKS_ENABLED=false
# 声明 optional 的工具是否也走任务通道
# MCP_TASKS_OPTIONAL_ASYNC=false
# 请求服务端保留任务的时长（毫秒）
# MCP_TASKS_TTL_MS=3600000

# 数据库：只支持 PostgreSQL。留空会在启动时报错，不会退回 SQLite。
DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/agent_platform

# ---------- 身份（平台签票 → 中台换会话） ----------
# off      = 不介入，保持单用户行为（默认；本地开发与既有测试不受影响）
# optional = 有中台会话就按会话，没有就匿名（灰度期）
# ticket   = 必须兑换拿到中台会话，否则 401（正式环境，多用户隔离走这条）
AUTH_MODE=off
# 子平台账号密码登录。密码只交给这个地址的 /auth/login 校验，中台不保存、不自己验。
# 地址必须带路径（例如 /api），且 AUTH_MODE 不能是 off。未配置时登录入口关闭。
# 身份绑定键是「企业 + 身份源 + 子平台用户」。PLATFORM_LOGIN_IDP 要和票据连接里的
# identity_provider_id 一致，同一人换登录方式才会落到同一个中台账号；两个子平台
# 即使用户编号相同也不会合并。
# BEEFTV_API_BASE=http://127.0.0.1:8080/api
# PLATFORM_LOGIN_TENANT=default
# PLATFORM_LOGIN_IDP=beeftv
# 每用户私有工作目录根。ticket 模式按租户/用户自动分配，生产环境不能手填服务器路径。
# 本机 macOS 且非 production 时，仍可「打开本地文件夹」。
# WORKSPACE_ROOT=workspaces
# ---------- 专家 · 技能 · 连接器（docs/addons.md） ----------
# 技能库根：一个技能一个目录（SKILL.md + references/ + scripts/）。
# 磁盘是唯一事实来源，库里不建技能索引表；上传/导入/内置安装都落在这里。
# SKILLS_DIR=profile/skills
# 技能包仓库：平台技能/远端技能的原件（<id>/<version>.zip）。发布只落这里，
# 用户点「+」安装才解包进 SKILLS_DIR——两者不能合并，因为"SKILLS_DIR 里有目录"
# 就等于"已安装"（见 docs/skillhub.md 4.2）。
# 目录里记的是**相对这里的路径**，所以整个目录搬到服务器后不用改数据。
# SKILLHUB_PACKAGES_DIR=profile/skillhub/packages
# 技能中心的运行数据：每个用户的安装清单（<tenant>__<user>.json）与平台目录。
# 部署时必须指到挂载卷：留在代码目录里，重新发布/重装就会把用户的安装记录清空。
# SKILLHUB_STATE_DIR=profile/skillhub
# 平台目录 JSON（管理员发布的技能与连接器）可以单独指到别处；默认在
# SKILLHUB_STATE_DIR 下的 platform_catalog.json。
# PLATFORM_CATALOG_FILE=profile/skillhub/platform_catalog.json
# 会话级技能物化目录名（相对当前工作目录，默认隐藏目录）。每轮只把该会话
# 选中的技能拷进去，模型用 read_file 相对路径按需读取；下一轮整体重建。
# SKILLS_WORKSPACE_DIRNAME=.agent-skills
# 技能包体积上限（MB），**默认 0 = 不限**。整包与单文件必须成对设置：
# 只放开整包、单文件还卡着，用户看到的是"包能传、装不上"。
# 内存/带宽有限时给个护栏，例如 200 / 50。
# SKILL_MAX_ARCHIVE_MB=0
# SKILL_MAX_MEMBER_MB=0
# 包内文件条数上限（默认 4000）。条数是 zip 炸弹的硬指标，与体积无关。
# SKILL_MAX_MEMBERS=4000
# 可信平台登记表（公钥只认这里的）。本地联调见 scripts/mock_identity_platform.py
# AUTH_CONNECTIONS_FILE=secrets/auth-connections.json
# AUTH_CONNECTIONS=[{...}]
AUTH_TICKET_MAX_LIFETIME=60
AUTH_SESSION_TTL=7200
AUTH_SESSION_COOKIE=agent_session
AUTH_COOKIE_SAMESITE=lax
# 本地 http 调试设 false，否则浏览器拒收；线上必须 true
AUTH_COOKIE_SECURE=true
AUTH_SSE_RECHECK=20
# ---------- 短信验证码登录（内部短信平台开放接口） ----------
# 方案 A：手机号独立身份源（identity_provider_id=sms，subject=手机号）。
# 服务根地址 / AK / SK 由短信平台维护方分配，禁止写入前端、Git 或普通日志。
# 三个凭据齐全且 SMS_LOGIN_ENABLED=true 时，前端才显示「短信验证码登录」入口。
# SMS_LOGIN_ENABLED=true
# SMS_BASE_URL=https://sms.example.com
# SMS_APP_KEY=your-app-key
# SMS_APP_SECRET=your-app-secret
# 短信平台请求超时（秒）。滑块/发码是同步请求，卡住就是用户卡住。
# SMS_TIMEOUT_SECONDS=10
# 短信登录身份源标识。默认 sms；改它会影响"手机号归属哪个中台账号"。
# SMS_IDENTITY_PROVIDER_ID=sms
# 能登记绑定和政策的中台用户。票据里自称管理员无效。本地单用户是 default。
AUTH_OPERATORS=default
# 浏览器写请求的 Origin。不配时，ticket 模式会拒绝带 Origin 的写请求。
# AUTH_ALLOWED_ORIGINS=https://platform.example
# ticket 模式启动时要求三个治理开关都打开。本地签票联调可设 true 跳过。
AUTH_DEV_COMPAT=false
# 异步工具合同。不配时，若 contracts/async_tools.json 存在就读它。
# ASYNC_CONTRACTS_FILE=contracts/async_tools.json
# 没有 manifest 的结果目录，超过这么多秒才允许运维清理。0 = 不清理。
RESULT_GC_GRACE_SECONDS=86400

# ---------- 对象权限 ----------
# owner_user_id='default' 的存量数据是否对所有登录用户可见。
# AUTH_MODE=ticket 时必须 false，否则等于把存量历史公开给所有登录用户。
POLICY_LEGACY_VISIBLE=false

# ---------- 运行中补充输入 ----------
# 任务跑着的时候再发一条消息，默认当作"给当前任务的补充要求"（不打断、不新建任务）。
# 关掉后前端退回旧行为：新消息 = 打断旧任务 + 新建任务。
RUN_INPUTS_ENABLED=true
# 单条补充的字符上限与待处理条数上限（在接受事务内检查）
RUN_INPUT_MAX_CHARS=4000
RUN_INPUT_MAX_PENDING=20
# 一次运行最多因补充要求修订几次计划；超过就停下来等人显式继续
RUN_MAX_REVISIONS=3

# ---------- 结果观察与自主决策 ----------
# 工具返回后先做程序观察（免费），只有片段结束/需要语义判断时才调用模型。
# 关掉后等价于"按计划一路跑完"，不会再根据结果调整后续步骤。
OBSERVE_ENABLED=true
# 一次运行最多几次自主决策、几次"确认未执行"的有限修复
RUN_MAX_DECISIONS=8
RUN_MAX_REPAIRS=2
# 运行级次数预算（跨重启累计，落在 runs.consumed_json）。
# 并发提到 16 后上游 429 变多，每次重试都吃这份次数，所以默认 32 而不是 24。
# token 不写进 consumed_json，只在 provider_charges 里按 run 汇总。
RUN_MAX_PROVIDER_REQUESTS=32
# 单次运行输入+输出 token 合计上限。事后记账，下一次模型请求前检查。
RUN_MAX_TOKENS=1000000
RUN_MAX_TOOL_CALLS=40
# 连续无进展（相同指纹）的容忍次数，超过就停
RUN_MAX_NO_PROGRESS=2

# ---------- 治理开关 ----------
# 本地单用户（AUTH_MODE=off）保持关闭。
# AUTH_MODE=ticket 且 AUTH_DEV_COMPAT=false 时，程序会把这三项打开，
# 这里写成 false 也不会关掉。只有 AUTH_DEV_COMPAT=true 时才按下面的值走。
TOOL_POLICY_ENFORCED=false
RESULT_ENVELOPE_V2=false
# 打开前应配置异步合同，声明远端任务号和查询工具，并运行 Worker。
ASYNC_TOOL_RUNTIME_ENABLED=false
# 多台机器时，ARTIFACT_DIR 必须是共享卷。画像文件也在这个进程能写到的目录里。
# stdio 子进程在同一进程内复用，空闲这么多秒后关闭。0 = 每次调用结束就关。
STDIO_SESSION_IDLE_SECONDS=600
# 单进程同时执行的运行数。到顶后新运行留在排队，本进程不再领取、不再起协程。
# 有名额空出来时，接口进程会补领它自己留下的运行；独立 Worker 也可以领。
MAX_CONCURRENT_RUNS=16

# Operational controls (production defaults/sample: deploy/production.env.example)
DB_POOL_SIZE=8
DB_POOL_TIMEOUT=10
# 等锁上限（毫秒，0=不限）。行锁 / 建议锁争用超过这个时间就报错，而不是无限排队
# 把池里 8 条连接逐个耗光。正常争用远低于 3 秒。
DB_LOCK_TIMEOUT_MS=3000
# 单条语句上限（毫秒，0=不限）。兜住跑飞的查询，避免长期占用连接。
# 结构迁移通道自动豁免，不会因为这条上限被掐断。
DB_STATEMENT_TIMEOUT_MS=30000
METRICS_FORMAT=json
RETENTION_EVENTS_DAYS=30
RETENTION_ARTIFACTS_DAYS=30
MAINTENANCE_INTERVAL_SECONDS=3600

# ---------- 执行器存活：防止「消息发出去没人回复」 ----------
# API 只接纳（202），模型调用由 Worker 领走执行。Worker 不在时，消息会永久
# 停在 accepted——页面上就是"发出去没回复"。下面这组参数决定怎么发现它。
# Worker 心跳间隔（秒）
WORKER_HEARTBEAT_SECONDS=5
# 超过这么久没有心跳就算离线
WORKER_ALIVE_WINDOW_SECONDS=20
# 没有活 Worker 时拒收消息（503）。生产默认 true；开发/测试默认 false，
# 否则没起 Worker 的单测会全部被挡。**不要**用它来"修复"故障。
# REQUIRE_LIVE_WORKER=true
# 僵尸 turn 看门狗：把没人执行的 turn 结算成失败并写一条用户可见的答复。
TURN_WATCHDOG_ENABLED=true
TURN_WATCHDOG_INTERVAL_SECONDS=15
# 接纳后多久没人领算卡死（无活 Worker 时）
TURN_ACCEPT_GRACE_SECONDS=120
# 有活 Worker 时的排队容忍上限（同会话串行、并发满都属正常排队）
TURN_QUEUE_WAIT_MAX_SECONDS=600
# 领取后租约过期再宽限多久判失联
TURN_LOST_GRACE_SECONDS=60

# 技能中心远端 SkillHub（可选）。
# native    = 自己的 SkillHub，SKILLHUB_URL 指向目录接口 /v1/skills
# workbuddy = lightmake / WorkBuddy 风格，SKILLHUB_URL 填站点根地址
# SKILLHUB_PROVIDER=native
# SKILLHUB_URL=https://your-skillhub.example.com/v1/skills
# WorkBuddy 公开目录示例（只保证目录读取；安装需要 SKILLHUB_PACKAGE_URL 模板）
# SKILLHUB_PROVIDER=workbuddy
# SKILLHUB_URL=https://lightmake.site
# SKILLHUB_REMOTE_LIMIT=300
# SKILLHUB_PACKAGE_URL=https://your-mirror.example.com/{slug}/{version}.zip
SKILLHUB_TTL=300

# 前端可切换的模型（逗号分隔，必须与 LLM_BASE_URL 网关支持的模型一致）
AVAILABLE_MODELS=deepseek-v4-1-flash,deepseek-chat,deepseek-reasoner

# ---------- 本地账号登录（第 4 种方式，docs/local-account-auth.md） ----------
# 默认关闭。打开后中台自己用 scrypt 校验密码，不影响平台账号 / 票据 OIDC / 短信。
# 生产环境要求 AUTH_COOKIE_SECURE=true 且密码至少 8 位，否则启动自检直接失败。
# LOCAL_AUTH_ENABLED=false
# 自助注册默认关闭；正式环境只允许超管在控制台手动建号。
# LOCAL_AUTH_ALLOW_SIGNUP=false
# 生产强制 >= 8；本机可设 4 以创建 test/test。
# LOCAL_AUTH_MIN_LENGTH=8
# 仅在 local_accounts 为空时执行一次，格式 user:pass[:role][,user2:pass2]。
# 也可以直接跑 python -m scripts.local_account_seed --username test --password test
# LOCAL_AUTH_SEED_USERS=
# 可选 pepper：只从环境变量读，绝不入库；轮换需全量重置密码。
# LOCAL_AUTH_PEPPER=
# 连续失败锁定阈值与时长（秒）。
# LOCAL_AUTH_LOCK_THRESHOLD=5
# LOCAL_AUTH_LOCK_SECONDS=900
# 身份源与租户标识；一期租户只支持 default。
# LOCAL_AUTH_IDP=local
# LOCAL_AUTH_TENANT=default

# ---------- 中台作为 OIDC 身份提供方（api/idp.py） ----------
# 打开后中台自己签发 id_token，子平台作为 OIDC 客户端接入。这是"中台在上、
# 子平台在下"的落地方式：身份主数据留在 app_users，不再需要 Keycloak 之类的
# 外部身份服务。与上面的 OIDC_* / PLATFORM_LOGIN_* 方向相反——那些是中台去登录
# 别人，这里是别人来登录中台。
# IDP_ENABLED=false
#
# issuer 必须与外部访问地址逐字节一致，且路径固定为 /api/idp（启动自检会校验）。
# 子平台会拿它和 discovery 文档里的值比对，靠请求头推断会因反向代理改写而失败。
# 末尾不要带斜杠。
# IDP_ISSUER=https://hub.example.com/api/idp
#
# 客户端注册表（JSON）。secret 留空表示公开客户端，只靠 PKCE 保护。
# redirect_uris 是**精确匹配**白名单，不做前缀/通配——开放重定向是这条链路
# 上最容易出的洞。子平台侧的回调路径通常被它自己锁死，例如 BeefTV 固定为
# /api/auth/oidc/callback。
# IDP_CLIENTS={"beeftv":{"secret":"换成随机串","redirect_uris":["https://beeftv.example.com/api/auth/oidc/callback"]}}
#
# id_token 有效期（秒）。子平台只在登录瞬间验一次，短窗口即可。
# IDP_ID_TOKEN_TTL=300
# 授权码有效期（秒）。一次性，取出即删。
# IDP_CODE_TTL=120
# 签名私钥路径。不存在时自动生成（0600），**不要提交进版本库**；换掉它等于
# 让所有子平台缓存的公钥失效。默认落在 secrets/ 下（已 gitignore）。
# IDP_KEY_PATH=secrets/idp_signing_key.pem
# 未登录时把用户送去哪里，会带 next 参数回跳到授权请求。
# IDP_LOGIN_PATH=/

# ---------- 机器人 / Bot Mode（docs/bot-mode.md） ----------
# 一个机器人 = 一行身份 + 一个规范会话 + 一份自己的记忆与家目录，不额外起进程。
# 关掉之后机器人面板写接口返回 403，Worker 也不再泵投递 / 推进群聊。
# BOT_MODE_ENABLED=true
# Worker 的机器人节拍（秒）：泵私信投递 + 推进群聊，两件事都不阻塞 run/turn 领取。
# BOT_TICK_SECONDS=3
# 一拍最多派发几条机器人私信、推进几个房间。
# BOT_DELIVERY_BATCH=5
# BOT_ROOM_BATCH=3
# 机器人之间最多转述几次：A→B→A→B 之后只落消息、不再自动回（防互相刷屏）。
# BOT_MAX_HOPS=2
# 群聊默认上限（创建房间时可以按房间覆盖）。
# BOT_ROOM_MAX_ROUNDS=3
# BOT_ROOM_MAX_MESSAGES=10

# ---------- 消息平台 / IM 网关（docs/messaging-platforms.md） ----------
# 把飞书 / 企业微信 / 个人微信接到中台的会话执行链：API 收、数据库中转、Worker 执行。
# 页面入口：左侧工具栏「消息平台」或 /api/ui/messaging。
# 总开关；关掉后写接口 403，Worker 也不再启动任何渠道连接。
# MESSAGING_ENABLED=true
# 回调渠道（飞书/企微）要求公网 HTTPS。没有它，这两个渠道会显示「待配置」，
# 而不是假装连上了。个人微信走长轮询，不需要这个地址。
# IM_PUBLIC_BASE_URL=https://im.example.com
# Worker 的网关节拍（秒）：同步配置、领入站、泵出站、写心跳。
# MESSAGING_TICK_SECONDS=3
# 一拍最多领几条入站、并发跑几条。
# MESSAGING_INBOX_BATCH=3
# MESSAGING_CONCURRENCY=3
# 一轮 IM 回复最多等多久（秒）。
# MESSAGING_REPLY_TIMEOUT_SECONDS=600
# 入站 / 出站失败重试上限；幂等窗口（秒）。
# MESSAGING_INBOX_MAX_ATTEMPTS=3
# MESSAGING_OUTBOX_MAX_ATTEMPTS=3
# MESSAGING_DEDUPE_TTL_SECONDS=86400
# 网关心跳窗口（秒）：超过这么久没有新心跳，控制面显示「网关未运行」。
# MESSAGING_ALIVE_WINDOW_SECONDS=45

# --- 飞书（自建应用 + 事件订阅回调）---
# 开放平台 → 凭证与基础信息。权限至少 im:message、im:message:send_as_bot。
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# 强烈建议开启事件订阅加密：开启后必须填 Encrypt Key。
# FEISHU_ENCRYPT_KEY=xxx
# 未开启加密时用 Verification Token 校验来源。
# FEISHU_VERIFICATION_TOKEN=xxx
# Lark 国际版把域名换成对应值；默认 https://open.feishu.cn
# FEISHU_BASE_URL=https://open.feishu.cn
#
# 一个机器人一个飞书应用（多实例）：除默认那一份外，每个实例的密钥加一段后缀，
# 后缀 = 实例 ID 大写（`bot_xzs` → `__BOT_XZS`）。**非默认实例不回落到基础键**：
# 回落等于两个机器人偷偷共用一个应用，那正是多实例要避免的事。
# 回调地址不用另配：所有实例共用 /api/messaging/webhook/feishu，服务端逐个
# 用各自的密钥验签，验得过的那份就是这条消息的归属。
# FEISHU_APP_ID__BOT_XZS=cli_xxx
# FEISHU_APP_SECRET__BOT_XZS=xxx
# FEISHU_ENCRYPT_KEY__BOT_XZS=xxx
# FEISHU_VERIFICATION_TOKEN__BOT_XZS=xxx

# --- 企业微信（自建应用 + API 接收回调）---
# 管理后台 → 应用管理 → 自建应用；接收消息里生成 Token 与 EncodingAESKey。
# WECOM_CORP_ID=ww_xxx
# WECOM_AGENT_ID=1000002
# WECOM_SECRET=xxx
# WECOM_TOKEN=xxx
# WECOM_AES_KEY=43位字符
# 可选：群机器人只发通知（不能收消息）。
# WECOM_BOT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# --- 个人微信（腾讯 iLink Bot，扫码登录）---
# 不需要预先填 token：页面「扫码登录」成功后自动写入 im_login_state。
# 默认值已经够用；只有腾讯下发不同域名时才需要改。
# WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com
# WEIXIN_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c
