LLM_API_KEY=replace-me
LLM_MODEL=replace-with-your-model-id
# 解析阶段关闭模型推理：实测多轮场景 4.4s → 2.3s（约 2 倍），准确率不变。
LLM_PARSE_DISABLE_THINKING=true
# 留空时使用 ChatOpenAI 适配器的默认 endpoint；其他兼容服务填完整 API base URL。
LLM_BASE_URL=
# 检索走 DeepSeek 官方 Search/Fetch API。
# 这个 key 是 api.deepseek.com 的平台 key，与 LLM_BASE_URL 的网关 key 不是一回事
# （拿网关 key 调官方接口会 401）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MAX_PAGES=3
# 字符预算，不是 token 数；长文会截断并记录限制。
# 单篇上限 × 来源数 ≈ 总量：单篇设成和总量一样大，第一个来源就吃光预算。
MAX_SOURCE_CHARS=3000
MAX_TOTAL_CHARS=6000
# Registered host platform scene budget; applies to every platform equally.
PLATFORM_CONTEXT_MAX_CHARS=12000
# 单次模型调用的硬超时（秒）。超时直接失败、不重试，换取确定的等待上限。
# 注意：它乘以重试次数要小于下面的 TASK_TIMEOUT，否则外层会先砍断内层重试。
LLM_ATTEMPT_TIMEOUT=180
# 完整模型请求预算。按实际模型的窗口配置，预留输出与安全余量。
# 输入使用 UTF-8 字节上界保守估算；包含规则、消息和工具 schema。
LLM_CONTEXT_WINDOW=32768
LLM_INPUT_BUDGET=24576
LLM_OUTPUT_TOKENS=4096
LLM_CONTEXT_MARGIN=2048
# 网络/限流有限重试的最长等待秒数；Retry-After 更长时不提前重发。
LLM_RETRY_MAX_DELAY=2
# ---------- 执行预算（步数/时长可配，不写死在代码里） ----------
# 计划最多几步
MAX_STEPS=8
# 单次任务总预算（秒）
TASK_TIMEOUT=300
# LangGraph 递归上限（每个步骤算一跳）
GRAPH_RECURSION_LIMIT=30
# run 租约时长（秒）。执行期间会持续续租；设太短，别的执行者会误判"人死了"并接手
RUN_LEASE_SECONDS=120
# 创建任务的幂等键有效期（秒）。客户端用 Idempotency-Key 头重试时，
# 同一个键 + 同样的内容只会产生一个任务；超过这个时间后键可以被重用。
IDEMPOTENCY_TTL_SECONDS=86400
# 日志级别：DEBUG / INFO / WARNING
LOG_LEVEL=INFO
ARTIFACT_DIR=artifacts
# 先设为 false，只生成本地 HTML。
DEPLOY_ENABLED=false
MCP_TRANSPORT=streamable_http
MCP_URL=https://your-server.example/mcp
MCP_BEARER_TOKEN=
# 对照 list_tools 的 inputSchema 填写。
MCP_TOOL_NAME=replace-with-real-tool-name
MCP_HTML_FIELD=html
MCP_EXTRA_ARGS={}
# 对照真实工具返回字段填写，可用点分隔路径，如 data.url。
MCP_RESULT_URL_FIELD=public_url

# ---------- 多 MCP Server（可选） ----------
# 设置 MCP_SERVERS 后，上面的 MCP_URL / MCP_TRANSPORT / MCP_TOOL_NAME 等
# 单项配置不再使用，改为每个服务端各自配置（JSON 数组）：
#   id            必填，工具名前缀用它（不能含 "__"）
#   transport     streamable_http / sse / stdio
#   url / token   http 类传输必填 url
#   stdio_command stdio 传输必填，stdio_args 为字符串数组
#   stdio_env     stdio 子进程的非敏感环境配置
#   forward_subject true 时从已验证运行注入 MCP_CALLER_SUBJECT，按客户隔离子进程
#   planning_tools 必须随业务工具保留的已授权上下文工具原始名称数组
#                 stdio 凭据由传输层注入 MCP_BEARER_TOKEN，不写入模型上下文
#   deploy_tool   这个服务端承接部署时用的工具名
#   default       true 表示由它承接 deploy_site 这类适配器工具
#   tool_hints    某个工具的本机用法，键是工具名或 run_tool 的内部名
#   prompt_rules  这一家自己的规划规则。只在它的工具进入本轮清单时拼进提示词。
#                 不要把某一家的工具名写进内核。
# 只有一个服务端时工具名仍是 mcp__<tool>（兼容已保存的计划）；
# 有多个时是 mcp__<server_id>__<tool>，避免同名工具跨服务端互相覆盖。
# MCP_SERVERS=[{"id":"publishing","url":"https://a.example/mcp","token":"","deploy_tool":"deploy_site","default":true},{"id":"ops","url":"https://b.example/mcp"}]

# 数据库：只支持 PostgreSQL。留空会在启动时报错，不会退回 SQLite。
DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/agent_platform

# ---------- 身份（平台签票 → 中台换会话） ----------
# off      = 不介入，保持单用户行为（默认；本地开发与既有测试不受影响）
# optional = 有中台会话就按会话，没有就匿名（灰度期）
# ticket   = 必须兑换拿到中台会话，否则 401（正式环境）
AUTH_MODE=off
# 可信平台登记表（公钥只认这里的）。本地联调见 scripts/mock_identity_platform.py
# AUTH_CONNECTIONS_FILE=secrets/auth-connections.json
# AUTH_CONNECTIONS=[{...}]
AUTH_TICKET_MAX_LIFETIME=60
AUTH_SESSION_TTL=7200
AUTH_SESSION_COOKIE=agent_session
AUTH_COOKIE_SAMESITE=lax
# 本地 http 调试设 false，否则浏览器拒收；线上必须 true
AUTH_COOKIE_SECURE=true
AUTH_SSE_RECHECK=20
# 能登记绑定和政策的中台用户。票据里自称管理员无效。本地单用户是 default。
AUTH_OPERATORS=default
# 浏览器写请求的 Origin。不配时，ticket 模式会拒绝带 Origin 的写请求。
# AUTH_ALLOWED_ORIGINS=https://platform.example
# ticket 模式启动时要求三个治理开关都打开。本地签票联调可设 true 跳过。
AUTH_DEV_COMPAT=false
# 异步工具合同。不配时，若 contracts/async_tools.json 存在就读它。
# ASYNC_CONTRACTS_FILE=contracts/async_tools.json
# 没有 manifest 的结果目录，超过这么多秒才允许运维清理。0 = 不清理。
RESULT_GC_GRACE_SECONDS=86400

# ---------- 对象权限 ----------
# owner_user_id='default' 的存量数据是否对所有登录用户可见。
# AUTH_MODE=ticket 时必须 false，否则等于把存量历史公开给所有登录用户。
POLICY_LEGACY_VISIBLE=false

# ---------- 运行中补充输入 ----------
# 任务跑着的时候再发一条消息，默认当作"给当前任务的补充要求"（不打断、不新建任务）。
# 关掉后前端退回旧行为：新消息 = 打断旧任务 + 新建任务。
RUN_INPUTS_ENABLED=true
# 单条补充的字符上限与待处理条数上限（在接受事务内检查）
RUN_INPUT_MAX_CHARS=4000
RUN_INPUT_MAX_PENDING=20
# 一次运行最多因补充要求修订几次计划；超过就停下来等人显式继续
RUN_MAX_REVISIONS=3

# ---------- 结果观察与自主决策 ----------
# 工具返回后先做程序观察（免费），只有片段结束/需要语义判断时才调用模型。
# 关掉后等价于"按计划一路跑完"，不会再根据结果调整后续步骤。
OBSERVE_ENABLED=true
# 一次运行最多几次自主决策、几次"确认未执行"的有限修复
RUN_MAX_DECISIONS=8
RUN_MAX_REPAIRS=2
# 运行级预算（跨重启累计，落在 runs.consumed_json）
RUN_MAX_PROVIDER_REQUESTS=24
RUN_MAX_TOOL_CALLS=40
# 连续无进展（相同指纹）的容忍次数，超过就停
RUN_MAX_NO_PROGRESS=2

# ---------- 治理开关 ----------
# 本地单用户（AUTH_MODE=off）保持关闭。
# AUTH_MODE=ticket 且 AUTH_DEV_COMPAT=false 时，程序会把这三项打开，
# 这里写成 false 也不会关掉。只有 AUTH_DEV_COMPAT=true 时才按下面的值走。
TOOL_POLICY_ENFORCED=false
RESULT_ENVELOPE_V2=false
# 打开前应配置异步合同，声明远端任务号和查询工具，并运行 Worker。
ASYNC_TOOL_RUNTIME_ENABLED=false
# 多台机器时，ARTIFACT_DIR 必须是共享卷。画像文件也在这个进程能写到的目录里。
# stdio 子进程在同一进程内复用，空闲这么多秒后关闭。0 = 每次调用结束就关。
STDIO_SESSION_IDLE_SECONDS=600
# 单进程同时执行的运行数。到顶后新运行留在排队，本进程不再领取、不再起协程。
# 有名额空出来时，接口进程会补领它自己留下的运行；独立 Worker 也可以领。
MAX_CONCURRENT_RUNS=8
